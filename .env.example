# Supabase Configuration
VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
VITE_PUBLIC_IMAGE_UPLOAD_PROVIDER=supabase
VITE_PUBLIC_R2_FUNCTION_NAME=r2-media

# Site URL (for OAuth redirects in production)
# Development: http://localhost:3000
# Production: https://propellacam.com or https://www.propellacam.com
VITE_PUBLIC_SITE_URL=https://propellacam.com

# Sentry Configuration (Error Tracking)
# Get your DSN from https://sentry.io/
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_APP_VERSION=1.0.0
